;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a workbench robot assists physical woodworking
;; and upholstery-repair tasks for furniture (ISIC 9524), gated by the Repair
;; Shop Governor. Its physical work here is steaming a replacement oak slat
;; (chair back / rocker) until its core is hot enough to bend, and lifting the
;; chair frame onto the repair bench.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-9524"
 :cases
 [{:id :oak-slat-steam-bending
   :kind :thermal
   :procedure "robot loads a replacement oak slat into the steam box; steam heats both faces, so half the slat thickness is modelled and the back face is its core, which must reach bending temperature"
   :params {:conductivity-w-mk 0.25 :density-kg-m3 750.0 :specific-heat-j-kgk 2000.0
            :t0-c 20.0 :t-hot-c 100.0 :h-front-w-m2k 100.0 :h-back-w-m2k 0.0
            :threshold-c 90.0 :duration-s 10800.0 :nodes 11}
   :sweep {:param :thickness-m :values [0.005 0.010 0.0127 0.015 0.020 0.025]}
   :quantity :time-to-threshold-s
   :limit {:max 3600.0 :basis "estimate: one steam-box hour per slat so the bend is made in the same session; the woodworkers' rule of thumb is about one hour per inch of thickness; moist-oak properties and condensing-steam heat transfer coefficient are estimates"}
   :boundary {:lo 0.002 :hi 0.03}}
  {:id :chair-frame-onto-bench
   :kind :manipulator
   :procedure "arm lifts a chair frame from the workshop floor onto the repair bench"
   :params {:l1-m 0.55 :l2-m 0.50 :m1-kg 6.0 :m2-kg 4.5
            :from [0.60 0.05] :to [0.40 0.60] :duration-s 3.0 :steps 500}
   :sweep {:param :payload-kg :values [3.0 6.0 9.0 12.0 15.0 20.0]}
   :quantity :peak-tau1-nm
   :limit {:max 150.0 :basis "estimate: continuous shoulder torque of a 12 kg-payload-class collaborative arm"}
   :boundary {:lo 0.5 :hi 50.0}}]}
